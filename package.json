{
  "name": "voxil-ai",
  "private": true,
  "version": "2.1.2",
  "type": "module",
  "scripts": {
    "pages": "node scripts/build-pages.js",
    "dev": "node scripts/build-pages.js && vite --host 0.0.0.0",
    "build": "node scripts/build-pages.js && node generate-sitemap.js && vite build && node post-build.js",
    "build:clean": "vite build && node post-build.js",
    "sitemap": "node generate-sitemap.js",
    "preview": "vite preview --host 0.0.0.0",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "html-minifier-terser": "^7.2.0",
    "prettier": "^3.6.2",
    "terser": "^5.43.1",
    "vite": "^6.3.1"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@tailwindcss/vite": "^4.1.4",
    "@vercel/analytics": "^2.0.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "^4.1.4",
    "vite-plugin-html-inject": "^1.1.2"
  }
}
